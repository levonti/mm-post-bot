MM_URL=https://mm.internal/
MM_BOT_TOKEN=replace-me-manager-bot-token
MM_ADMINS=admin_username
MM_VERIFY_SSL=true
DB_URL=postgresql://mm_post:replace-with-strong-password@postgres/mm_post_bot
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
WEB_BASE_URL=http://localhost:8080
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_COOKIE_SECURE=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_LOGIN_TOKEN_TTL_SECONDS=300
WEB_SESSION_MAX_AGE_SECONDS=604800
